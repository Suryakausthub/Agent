# Copy to .env and fill in. Never commit .env.
GROQ_API_KEY=gsk_your_key_here

# Optional but recommended for GitHub project discovery.
# Classic PAT, "public_repo" scope only (read-only). Without it GitHub allows
# 60 requests/hour, which is not enough to check READMEs and authorship across
# 75 repositories, so those signals are skipped and more repos land in REVIEW.
GITHUB_TOKEN=
